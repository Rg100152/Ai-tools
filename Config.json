  "system_requirements": {
    "operating_system": ["Linux", "macOS", "Windows"],
    "python_version": "3.6+",
    "terminal": ["bash", "zsh", "fish", "powershell"],
    "internet_connection": true,
    "display": "ANSI color support",
    "minimum_screen_width": 80,
    "minimum_screen_height": 24
  },

  "features": {
    "quick_access": true,
    "category_browsing": true,
    "search": true,
    "favorites": true,
    "history": true,
    "random_tool": true,
    "help_menu": true,
    "developer_info": true,
    "matrix_effect": true,
    "loading_animation": true,
    "auto_update": true,
    "export_list": true,
    "import_favorites": true,
    "clear_screen": true,
    "keyboard_shortcuts": true,
    "paginated_menu": true,
    "tool_description": true,
    "price_display": true,
    "url_display": true,
    "type_filtering": true,
    "multi_language": false,
    "custom_themes": true,
    "command_line_args": true,
    "log_usage": true
  },

  "logging": {
    "enabled": true,
    "level": "INFO",
    "levels": ["DEBUG", "INFO", "WARNING", "ERROR", "CRITICAL"],
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": "ai_tools.log",
    "max_file_size": "10MB",
    "backup_count": 5
  },

  "notifications": {
    "on_tool_open": true,
    "on_favorite_add": true,
    "on_favorite_remove": true,
    "on_update_available": true,
    "on_error": true,
    "sound_enabled": false,
    "desktop_notifications": false
  },

  "network": {
    "timeout": 10,
    "retry_attempts": 3,
    "check_ssl": true,
    "proxy": "",
    "user_agent": "AI-Tools-Launcher/3.0.0"
  },

  "export_options": {
    "format": ["txt", "csv", "json", "html"],
    "include_description": true,
    "include_price": true,
    "include_url": true,
    "include_type": true,
    "sort_by": ["name", "type", "price"],
    "filename_pattern": "ai_tools_export_{timestamp}.{format}"
  },

